# ---- Required ----------------------------------------------------------
# Local MongoDB:  mongodb://localhost:27017
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=save-lives

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Optional ----------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Accounts with these emails become admins (comma-separated)
ADMIN_EMAILS=
# Add sample donors and requests on first start so the site isn't empty
SEED_DEMO_DATA=false
